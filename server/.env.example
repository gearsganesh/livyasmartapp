NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:[URL_ENCODED_PASSWORD]@[DESIGNATED_PROJECT_DB_HOST]:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-at-least-32-random-bytes-before-starting"
CLIENT_ORIGINS="http://localhost:5173"
COOKIE_NAME="livya_session"
ALLOW_PUBLIC_REGISTRATION="false"
# Optional, used only by the first-run bootstrap command. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-16-characters"
BOOTSTRAP_ADMIN_NAME="LIVYA Administrator"
