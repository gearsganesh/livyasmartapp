generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CLINICIAN
  NUTRITIONIST
  THERAPIST
  STAFF
  CLIENT
  LAB_PARTNER
}
enum RecordStatus {
  DRAFT
  ACTIVE
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
enum BookingStatus {
  REQUESTED
  CONFIRMED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  passwordHash String?
  fullName String @db.VarChar(160)
  role UserRole @default(CLIENT)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  patientProfile Patient?
  auditEvents AuditLog[] @relation("AuditActor")
  createdPatients Patient[] @relation("PatientCreator")
  clinicianAppointments Appointment[] @relation("AppointmentClinician")
  @@index([role,isActive])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId,expiresAt])
}
model Patient {
  id String @id @default(uuid()) @db.Uuid
  patientCode String? @unique @db.VarChar(40)
  userId String? @unique @db.Uuid
  fullName String @db.VarChar(160)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(32)
  dateOfBirth DateTime?
  sex String? @db.VarChar(40)
  status RecordStatus @default(ACTIVE)
  primaryCondition String? @db.VarChar(240)
  notes String? @db.Text
  metadata Json?
  createdById String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User? @relation("PatientCreator",fields:[createdById],references:[id],onDelete:SetNull)
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  appointments Appointment[]
  vitalAlerts VitalAlert[]
  clinicalRecords ClinicalRecord[]
  reports PatientReport[]
  labResults LabResult[]
  prescriptions Prescription[]
  nutritionAssessments NutritionAssessment[]
  planAssignments PatientPlan[]
  consumption PlanConsumption[]
  aiReviews AIReview[]
  labBookings LabBooking[]
  storeOrders StoreOrder[]
  invoices Invoice[]
  therapistAssignments TherapistAssignment[]
  messages Message[]
  @@index([fullName])
  @@index([status,createdAt])
}
model Appointment {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  clinicianId String? @db.Uuid
  title String @db.VarChar(180)
  appointmentType String @default("Consultation") @db.VarChar(100)
  startAt DateTime
  endAt DateTime?
  status AppointmentStatus @default(REQUESTED)
  location String? @db.VarChar(240)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  clinician User? @relation("AppointmentClinician",fields:[clinicianId],references:[id],onDelete:SetNull)
  @@index([startAt,status])
  @@index([patientId,startAt])
}
model VitalAlert {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  title String @db.VarChar(180)
  metric String @db.VarChar(100)
  observedValue String @db.VarChar(100)
  threshold String? @db.VarChar(100)
  severity AlertSeverity @default(MEDIUM)
  status AlertStatus @default(OPEN)
  notes String? @db.Text
  reviewedBy String? @db.Uuid
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  @@index([status,severity,createdAt])
}
model ClinicalRecord {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  recordType String @db.VarChar(100)
  title String @db.VarChar(180)
  content Json
  status RecordStatus @default(PENDING)
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  @@index([patientId,recordType,createdAt])
}
model Medicine {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  genericName String? @db.VarChar(180)
  strength String? @db.VarChar(100)
  dosageForm String? @db.VarChar(100)
  manufacturer String? @db.VarChar(180)
  sku String? @unique @db.VarChar(80)
  unitPrice Decimal? @db.Decimal(12,2)
  stockQuantity Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prescriptionItems PrescriptionItem[]
  @@index([name])
}
model Prescription {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  prescribedBy String? @db.Uuid
  status RecordStatus @default(ACTIVE)
  issuedAt DateTime @default(now())
  validUntil DateTime?
  instructions String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  items PrescriptionItem[]
  @@index([patientId,issuedAt])
}
model PrescriptionItem {
  id String @id @default(uuid()) @db.Uuid
  prescriptionId String @db.Uuid
  medicineId String? @db.Uuid
  medicineName String @db.VarChar(180)
  dosage String? @db.VarChar(120)
  frequency String? @db.VarChar(120)
  duration String? @db.VarChar(120)
  quantity Int @default(1)
  instructions String? @db.Text
  prescription Prescription @relation(fields:[prescriptionId],references:[id],onDelete:Cascade)
  medicine Medicine? @relation(fields:[medicineId],references:[id],onDelete:SetNull)
  @@index([prescriptionId])
}
model NutritionAssessment {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  assessedBy String? @db.Uuid
  assessmentDate DateTime @default(now())
  weightKg Decimal? @db.Decimal(6,2)
  heightCm Decimal? @db.Decimal(6,2)
  dietaryPreferences String? @db.Text
  goals String? @db.Text
  assessment Json?
  recommendations Json?
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  @@index([patientId,assessmentDate])
}
model Program {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  category String @db.VarChar(100)
  description String? @db.Text
  durationDays Int?
  price Decimal? @db.Decimal(12,2)
  status RecordStatus @default(ACTIVE)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments PatientPlan[]
  @@index([category,status])
}
model PatientPlan {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  programId String @db.Uuid
  startDate DateTime @default(now())
  endDate DateTime?
  status RecordStatus @default(ACTIVE)
  goals Json?
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  program Program @relation(fields:[programId],references:[id],onDelete:Restrict)
  @@index([patientId,status])
}
model PlanConsumption {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  planAssignmentId String? @db.Uuid
  itemName String @db.VarChar(180)
  quantity Decimal @default(1) @db.Decimal(10,2)
  unit String? @db.VarChar(40)
  consumedAt DateTime @default(now())
  notes String? @db.Text
  createdAt DateTime @default(now())
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  @@index([patientId,consumedAt])
}
model SOP {
  id String @id @default(uuid()) @db.Uuid
  title String @db.VarChar(200)
  category String @db.VarChar(100)
  version String @default("1.0") @db.VarChar(30)
  content String @db.Text
  status RecordStatus @default(ACTIVE)
  ownerId String? @db.Uuid
  effectiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category,status])
}
model RolePermission {
  id String @id @default(uuid()) @db.Uuid
  role UserRole
  resource String @db.VarChar(100)
  canRead Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([role,resource])
}
model AIReview {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  recordId String? @db.Uuid
  reviewType String @db.VarChar(100)
  status RecordStatus @default(PENDING)
  inputSummary String? @db.Text
  output Json?
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  @@index([status,createdAt])
}
model Therapy {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  category String @db.VarChar(100)
  description String? @db.Text
  durationMinutes Int?
  price Decimal? @db.Decimal(12,2)
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  therapistAssignments TherapistAssignment[]
  @@index([category,status])
}
model Therapist {
  id String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(160)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(32)
  specializations String[] @default([])
  status RecordStatus @default(ACTIVE)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments TherapistAssignment[]
  @@index([fullName])
}
model TherapistAssignment {
  id String @id @default(uuid()) @db.Uuid
  therapistId String @db.Uuid
  therapyId String @db.Uuid
  patientId String @db.Uuid
  scheduledAt DateTime?
  status RecordStatus @default(PENDING)
  notes String? @db.Text
  createdAt DateTime @default(now())
  therapist Therapist @relation(fields:[therapistId],references:[id],onDelete:Cascade)
  therapy Therapy @relation(fields:[therapyId],references:[id],onDelete:Restrict)
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  @@index([scheduledAt,status])
}
model StoreProduct {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  sku String? @unique @db.VarChar(80)
  category String @db.VarChar(100)
  description String? @db.Text
  price Decimal @db.Decimal(12,2)
  stockQuantity Int @default(0)
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems StoreOrderItem[]
  @@index([category,status])
}
model StoreOrder {
  id String @id @default(uuid()) @db.Uuid
  orderNumber String @unique @db.VarChar(60)
  patientId String @db.Uuid
  status OrderStatus @default(PENDING)
  currency String @default("INR") @db.VarChar(3)
  subtotal Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  total Decimal @default(0) @db.Decimal(12,2)
  shippingAddress Json?
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  items StoreOrderItem[]
  @@index([status,createdAt])
}
model StoreOrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  productId String? @db.Uuid
  productName String @db.VarChar(180)
  quantity Int @default(1)
  unitPrice Decimal @db.Decimal(12,2)
  order StoreOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product StoreProduct? @relation(fields:[productId],references:[id],onDelete:SetNull)
  @@index([orderId])
}
model LabPartner {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(180)
  contactName String? @db.VarChar(160)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(32)
  address String? @db.Text
  services String[] @default([])
  status RecordStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings LabBooking[]
  @@index([name,status])
}
model LabBooking {
  id String @id @default(uuid()) @db.Uuid
  bookingNumber String @unique @db.VarChar(60)
  patientId String @db.Uuid
  labPartnerId String @db.Uuid
  testName String @db.VarChar(180)
  scheduledAt DateTime?
  status BookingStatus @default(REQUESTED)
  resultDocumentUrl String? @db.Text
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade)
  labPartner LabPartner @relation(fields:[labPartnerId],references:[id],onDelete:Restrict)
  @@index([patientId,status])
  @@index([scheduledAt])
}
model Message {
  id String @id @default(uuid()) @db.Uuid
  patientId String? @db.Uuid
  senderId String @db.Uuid
  recipientId String? @db.Uuid
  subject String? @db.VarChar(200)
  body String @db.Text
  readAt DateTime?
  createdAt DateTime @default(now())
  patient Patient? @relation(fields:[patientId],references:[id],onDelete:SetNull)
  @@index([recipientId,readAt,createdAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String @db.VarChar(100)
  resource String @db.VarChar(100)
  resourceId String? @db.VarChar(100)
  metadata Json?
  ipAddress String? @db.VarChar(64)
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor",fields:[actorId],references:[id],onDelete:SetNull)
  @@index([resource,resourceId,createdAt])
  @@index([actorId,createdAt])
}


model Invoice {
  id String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique @db.VarChar(40)
  patientId String @db.Uuid
  invoiceDate DateTime @default(now())
  dueDate DateTime?
  status String @default("DRAFT") @db.VarChar(30)
  currency String @default("INR") @db.VarChar(3)
  subtotal Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  total Decimal @default(0) @db.Decimal(12,2)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  @@index([patientId,invoiceDate])
  @@index([status,dueDate])
}

model PatientReport {
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  reportType String @default("Laboratory") @db.VarChar(80)
  title String @db.VarChar(180)
  reportDate DateTime @db.Date
  originalFileName String @db.VarChar(255)
  storagePath String @unique @db.Text
  mimeType String @default("application/pdf") @db.VarChar(100)
  fileSize BigInt
  extractionStatus String @default("NOT_STARTED") @db.VarChar(40)
  reviewStatus String @default("PENDING") @db.VarChar(40)
  extractionError String? @db.Text
  uploadedBy String? @db.Uuid
  extractedAt DateTime?
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labResults LabResult[]
  @@index([patientId, reportDate])
  @@index([extractionStatus, reviewStatus])
}

model LabResult {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  patientId String @db.Uuid
  testName String @db.VarChar(180)
  testCode String? @db.VarChar(100)
  value Decimal? @db.Decimal(18, 6)
  unit String? @db.VarChar(80)
  referenceRangeText String? @db.VarChar(160)
  referenceLow Decimal? @db.Decimal(18, 6)
  referenceHigh Decimal? @db.Decimal(18, 6)
  labFlag String? @db.VarChar(40)
  resultDate DateTime @db.Date
  confidence Decimal? @db.Decimal(4, 3)
  sourceText String? @db.Text
  reviewStatus String @default("PENDING") @db.VarChar(40)
  reviewedBy String? @db.Uuid
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  report PatientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, testName, resultDate])
  @@index([reportId])
}
